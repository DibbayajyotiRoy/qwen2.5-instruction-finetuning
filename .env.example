# Hugging Face Hub token (optional but recommended for gated models)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Weights & Biases (optional; leave blank to use TensorBoard only)
WANDB_PROJECT=qwen25-instruction-finetuning
WANDB_API_KEY=

# CUDA / training
CUDA_VISIBLE_DEVICES=0
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Reproducibility
SEED=42

# Paths (defaults can be overridden in config)
OUTPUT_DIR=outputs
DATA_DIR=data
